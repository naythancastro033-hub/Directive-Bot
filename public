<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Directive™ | Axiom Systems™</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        obsidian: '#09090b',
                        carddark: '#121216',
                        accent: '#8b5cf6',
                        accenthover: '#7c3aed'
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-obsidian text-zinc-100 font-sans min-h-screen flex flex-col selection:bg-accent selection:text-white">

    <!-- Navbar -->
    <nav class="border-b border-zinc-800 bg-obsidian/80 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-600 to-indigo-900 flex items-center justify-center shadow-lg shadow-purple-900/20">
                    <i data-lucide="shield" class="w-5 h-5 text-white"></i>
                </div>
                <div>
                    <span class="font-bold tracking-wider text-lg block">DIRECTIVE™</span>
                    <span class="text-xs text-zinc-400 block -mt-1">by Axiom Systems™</span>
                </div>
            </div>
            <div class="flex items-center space-x-4">
                <button onclick="scrollToSection('commands')" class="text-sm text-zinc-400 hover:text-white transition hidden md:block">Commands</button>
                <button onclick="scrollToSection('telemetry')" class="text-sm text-zinc-400 hover:text-white transition hidden md:block">Telemetry</button>
                <button onclick="openAdminModal()" class="flex items-center space-x-2 bg-zinc-900 hover:bg-zinc-800 border border-zinc-700/60 px-4 py-2 rounded-xl text-sm font-medium transition shadow-sm">
                    <i data-lucide="lock" class="w-4 h-4 text-purple-400"></i>
                    <span>Developer Portal</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-6 pt-20 pb-16 text-center lg:text-left flex flex-col lg:flex-row items-center justify-between gap-12">
        <div class="max-w-2xl">
            <div class="inline-flex items-center space-x-2 bg-purple-950/40 border border-purple-800/40 px-3 py-1 rounded-full text-xs text-purple-300 mb-6">
                <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
                <span>Enterprise Security Infrastructure Active</span>
            </div>
            <h1 class="text-4xl lg:text-6xl font-extrabold tracking-tight mb-6">
                Next-Gen Discord <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-indigo-400">Server Security</span>
            </h1>
            <p class="text-zinc-400 text-lg mb-8 leading-relaxed">
                Directive™ provides robust anti-raid protocols, automated telemetry diagnostics, and granular developer management dashboards engineered by Axiom Systems™.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                <a href="https://discord.com/api/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=8&scope=bot%20applications.commands" target="_blank" class="w-full sm:w-auto bg-purple-600 hover:bg-purple-700 text-white font-medium px-8 py-3.5 rounded-xl shadow-lg shadow-purple-600/25 transition flex items-center justify-center space-x-2">
                    <i data-lucide="plus-circle" class="w-5 h-5"></i>
                    <span>Deploy Directive™</span>
                </a>
                <button onclick="scrollToSection('commands')" class="w-full sm:w-auto bg-carddark hover:bg-zinc-800 border border-zinc-800 text-zinc-300 font-medium px-8 py-3.5 rounded-xl transition flex items-center justify-center space-x-2">
                    <i data-lucide="terminal" class="w-5 h-5 text-purple-400"></i>
                    <span>Explore Commands</span>
                </button>
            </div>
        </div>

        <!-- Telemetry Card Widget -->
        <div id="telemetry" class="w-full lg:w-96 bg-carddark border border-zinc-800/80 p-6 rounded-2xl shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 right-0 p-6 opacity-10">
                <i data-lucide="cpu" class="w-24 h-24 text-purple-400"></i>
            </div>
            <h3 class="text-sm font-semibold text-zinc-400 uppercase tracking-wider mb-4 flex items-center space-x-2">
                <i data-lucide="activity" class="w-4 h-4 text-purple-400"></i>
                <span>Live System Telemetry</span>
            </h3>
            <div class="space-y-4">
                <div class="flex justify-between items-center bg-zinc-900/60 p-3.5 rounded-xl border border-zinc-800/50">
                    <span class="text-sm text-zinc-400">Core Status</span>
                    <span id="status-badge" class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center space-x-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                        <span id="status-text">ONLINE</span>
                    </span>
                </div>
                <div class="flex justify-between items-center bg-zinc-900/60 p-3.5 rounded-xl border border-zinc-800/50">
                    <span class="text-sm text-zinc-400">Gateway Latency</span>
                    <span id="telemetry-ping" class="font-mono text-purple-300">-- ms</span>
                </div>
                <div class="flex justify-between items-center bg-zinc-900/60 p-3.5 rounded-xl border border-zinc-800/50">
                    <span class="text-sm text-zinc-400">Active Guilds</span>
                    <span id="telemetry-guilds" class="font-mono text-purple-300">--</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Command Directory -->
    <section id="commands" class="max-w-7xl mx-auto px-6 py-16 border-t border-zinc-800/60">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <h2 class="text-3xl font-bold mb-4">Command Directory</h2>
            <p class="text-zinc-400">Built-in slash commands engineered for comprehensive administrative oversight.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-carddark border border-zinc-800 p-6 rounded-2xl">
                <code class="text-purple-400 font-mono font-bold block mb-2">/ping</code>
                <p class="text-sm text-zinc-400">Check Directive™ system latency and API websocket status.</p>
            </div>
            <div class="bg-carddark border border-zinc-800 p-6 rounded-2xl">
                <code class="text-purple-400 font-mono font-bold block mb-2">/serverinfo</code>
                <p class="text-sm text-zinc-400">Display detailed server security metrics and telemetry overview.</p>
            </div>
            <div class="bg-carddark border border-zinc-800 p-6 rounded-2xl">
                <code class="text-purple-400 font-mono font-bold block mb-2">/verify</code>
                <p class="text-sm text-zinc-400">Initiate member verification protocols and access gateway.</p>
            </div>
            <div class="bg-carddark border border-zinc-800 p-6 rounded-2xl">
                <code class="text-purple-400 font-mono font-bold block mb-2">/lockdown</code>
                <p class="text-sm text-zinc-400">Restrict public channel access during elevated threat levels.</p>
            </div>
            <div class="bg-carddark border border-zinc-800 p-6 rounded-2xl">
                <code class="text-purple-400 font-mono font-bold block mb-2">/audit</code>
                <p class="text-sm text-zinc-400">Run security diagnostics on server roles and permissions.</p>
            </div>
            <div class="bg-carddark border border-zinc-800 p-6 rounded-2xl">
                <code class="text-purple-400 font-mono font-bold block mb-2">/health</code>
                <p class="text-sm text-zinc-400">Check bot operational uptime and active heap memory usage.</p>
            </div>
            <div class="bg-carddark border border-zinc-800 p-6 rounded-2xl md:col-span-2 lg:col-span-3">
                <code class="text-purple-400 font-mono font-bold block mb-2">/purge [amount]</code>
                <p class="text-sm text-zinc-400">Bulk remove recent chat messages securely from the active channel.</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="mt-auto border-t border-zinc-800/80 py-8 bg-carddark/50">
        <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 gap-4">
            <p>© 2026 Axiom Systems™. All Rights Reserved. Directive™ is a trademark of Axiom Systems™.</p>
            <div class="flex space-x-6">
                <span class="hover:text-zinc-400 transition cursor-pointer">Security Policy</span>
                <span class="hover:text-zinc-400 transition cursor-pointer">API Status</span>
            </div>
        </div>
    </footer>

    <!-- Developer Admin Portal Modal -->
    <div id="admin-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-carddark border border-zinc-800 w-full max-w-md rounded-2xl p-6 relative shadow-2xl">
            <button onclick="closeAdminModal()" class="absolute top-4 right-4 text-zinc-400 hover:text-white">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
            <div class="flex items-center space-x-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-400">
                    <i data-lucide="shield-alert" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="font-bold text-lg">Developer Portal</h3>
                    <p class="text-xs text-zinc-400">Enter your Administrator Key to authenticate.</p>
                </div>
            </div>
            
            <form id="auth-form" onsubmit="handleAuth(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-2">ADMIN DEVELOPER KEY</label>
                    <input type="password" id="admin-key-input" placeholder="Enter secure key..." required class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-purple-500 transition">
                </div>
                <div id="auth-error" class="text-xs text-red-400 hidden"></div>
                <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-medium py-3 rounded-xl transition shadow-lg shadow-purple-600/20">
                    Authenticate Session
                </button>
            </form>

            <div id="admin-panel" class="hidden space-y-4 mt-2">
                <div class="bg-emerald-500/10 border border-emerald-500/20 p-4 rounded-xl text-emerald-400 text-xs flex items-center space-x-2">
                    <i data-lucide="check-circle" class="w-4 h-4"></i>
                    <span>Authentication Successful. Root Developer Access Granted.</span>
                </div>
                <div class="space-y-2 bg-zinc-900/50 p-4 rounded-xl border border-zinc-800">
                    <span class="text-xs font-semibold text-zinc-400 block mb-1">SYSTEM CONTROLS</span>
                    <p class="text-xs text-zinc-400">Connected Bot Client ID and token variables are securely bound via environment storage on Render.</p>
                </div>
                <button onclick="closeAdminModal()" class="w-full bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-medium py-2.5 rounded-xl transition">
                    Close Portal
                </button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        lucide.createIcons();

        function scrollToSection(id) {
            document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
        }

        function openAdminModal() {
            document.getElementById('admin-modal').classList.remove('hidden');
        }

        function closeAdminModal() {
            document.getElementById('admin-modal').classList.add('hidden');
            document.getElementById('admin-key-input').value = '';
            document.getElementById('auth-error').classList.add('hidden');
            document.getElementById('auth-form').classList.remove('hidden');
            document.getElementById('admin-panel').classList.add('hidden');
        }

        async function handleAuth(event) {
            event.preventDefault();
            const key = document.getElementById('admin-key-input').value;
            const errorDiv = document.getElementById('auth-error');

            try {
                const response = await fetch('/api/auth/verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ key })
                });
                const data = await response.json();

                if (data.success) {
                    document.getElementById('auth-form').classList.add('hidden');
                    document.getElementById('admin-panel').classList.remove('hidden');
                } else {
                    errorDiv.textContent = data.message || 'Invalid Admin Developer Key.';
                    errorDiv.classList.remove('hidden');
                }
            } catch (err) {
                errorDiv.textContent = 'Server communication error.';
                errorDiv.classList.remove('hidden');
            }
        }

        // Fetch Telemetry Periodic Polling
        async function fetchTelemetry() {
            try {
                const res = await fetch('/api/telemetry');
                const data = await res.json();
                document.getElementById('telemetry-ping').textContent = data.ping ? `${data.ping} ms` : '0 ms';
                document.getElementById('telemetry-guilds').textContent = data.guildCount || '0';
            } catch (err) {
                console.error('Failed to update telemetry widget');
            }
        }

        setInterval(fetchTelemetry, 5000);
        fetchTelemetry();
    </script>
</body>
</html>
